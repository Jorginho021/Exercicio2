package exercicio.pkg1;

import java.util.Scanner;

public class Exercicio1 {

  
    public static void main(String[] args) {
           Scanner sc = new Scanner(System.in);

        // Criar objeto Palavra
        Palavra palavra = new Palavra();

        // Solicitar ao usuário que digite uma palavra
        System.out.print("Digite uma palavra: ");
        String entrada = sc.nextLine();

        // Definir a palavra usando o setter
        palavra.setTexto(entrada);

        // Contar letras usando o método da classe
        int quantidadeLetras = palavra.contarLetras();

        // Exibir o resultado
        System.out.println("A palavra \"" + palavra.getTexto() + "\" possui " + quantidadeLetras + " letras.");

        sc.close();
    }
}
  //Classe Palavra

package exercicio.pkg1;

public class Palavra {
       // Atributo privado
    private String texto;

    // Construtor
    public Palavra() {
    }

    public Palavra(String texto) {
        this.texto = texto;
    }

    // Getter
    public String getTexto() {
        return texto;
    }

    // Setter
    public void setTexto(String texto) {
        this.texto = texto;
    }

    // Método para contar letras
    public int contarLetras() {
        if (texto != null) {
            return texto.length();
        } else {
            return 0;
        }
    }
}


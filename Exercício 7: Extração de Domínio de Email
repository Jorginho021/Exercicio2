package exercicio7;

import java.util.Scanner;

public class Exercicio7 {

    public static void main(String[] args) {
      Scanner scanner = new Scanner(System.in);

        // Solicita o email do usuário
        System.out.print("Digite seu endereço de email: ");
        String email = scanner.nextLine().trim();

        // Verifica se o email contém '@'
        if (email.contains("@")) {
            // Encontra a posição do '@'
            int indiceArroba = email.indexOf('@');

            // Extrai o domínio
            String dominio = email.substring(indiceArroba + 1);

            // Exibe o domínio
            System.out.println("O domínio do seu email é: " + dominio);
        } else {
            System.out.println("Email inválido! O endereço deve conter '@'.");
        }

        scanner.close();
    }
}

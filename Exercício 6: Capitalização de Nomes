    package exercici6;

import java.util.Scanner;

public class Exercici6 {

    public static void main(String[] args) {
          Scanner sc = new Scanner(System.in);

        // Criar objeto Nome
        Nome nome = new Nome();

        // Solicitar ao usuário que digite o nome completo
        System.out.print("Digite seu nome completo: ");
        String entrada = sc.nextLine();

        // Definir o nome usando o setter
        nome.setTexto(entrada);

        // Capitalizar usando o método da classe
        String nomeFormatado = nome.capitalizar();

        // Exibir o resultado
        System.out.println("Nome formatado: " + nomeFormatado);

        sc.close();
    }
    
}

//Classe Nome

package exercici6;


public class Nome {
          // Atributo privado
    private String texto;

    // Construtor
    public Nome() {
    }

    public Nome(String texto) {
        this.texto = texto;
    }

    // Getter
    public String getTexto() {
        return texto;
    }

    // Setter
    public void setTexto(String texto) {
        this.texto = texto;
    }

    // Método para capitalizar a primeira letra de cada palavra
    public String capitalizar() {
        if (texto == null || texto.trim().isEmpty()) {
            return "";
        }

        String[] palavras = texto.trim().toLowerCase().split("\\s+");
        StringBuilder nomeCapitalizado = new StringBuilder();

        for (String palavra : palavras) {
            if (palavra.length() > 0) {
                nomeCapitalizado.append(Character.toUpperCase(palavra.charAt(0)))
                                .append(palavra.substring(1))
                                .append(" ");
            }
        }

        return nomeCapitalizado.toString().trim();
    }
}


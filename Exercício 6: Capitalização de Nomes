package exercicio06;

import java.util.Scanner;

public class Exercicio06 {

    public static void main(String[] args) {
      
      Scanner scanner = new Scanner(System.in);

        // Solicita o nome completo do usuário
        System.out.print("Digite seu nome completo: ");
        String nomeCompleto = scanner.nextLine().trim();

        // Divide o nome em partes, separando pelos espaços
        String[] partes = nomeCompleto.split("\\s+");

        // StringBuilder para armazenar o nome formatado
        StringBuilder nomeFormatado = new StringBuilder();

        // Percorre cada palavra do nome e capitaliza a primeira letra
        for (String palavra : partes) {
            if (!palavra.isEmpty()) {
                // Primeira letra maiúscula + restante minúsculo
                nomeFormatado.append(Character.toUpperCase(palavra.charAt(0)))
                             .append(palavra.substring(1).toLowerCase())
                             .append(" ");
            }
        }

        // Exibe o nome formatado
        System.out.println("Nome formatado: " + nomeFormatado.toString().trim());

        scanner.close();
    }
}

package exercicio.pkg10;

import java.util.Scanner;


public class Exercicio10 {

    public static void main(String[] args) {
          Scanner scanner = new Scanner(System.in);

        // Solicita a palavra do usuário
        System.out.print("Digite uma palavra: ");
        String palavra = scanner.nextLine().toLowerCase().trim();

        int vogais = 0;
        int consoantes = 0;

        // Define as vogais para comparação
        String letrasVogais = "aeiou";

        // Percorre cada caractere da palavra
        for (int i = 0; i < palavra.length(); i++) {
            char c = palavra.charAt(i);

            // Verifica se é uma letra (ignora números, acentos e espaços)
            if (Character.isLetter(c)) {
                if (letrasVogais.indexOf(c) != -1) {
                    vogais++;
                } else {
                    consoantes++;
                }
            }
        }

        // Exibe o resultado
        System.out.println("Quantidade de vogais: " + vogais);
        System.out.println("Quantidade de consoantes: " + consoantes);

        scanner.close();
    }
}
  

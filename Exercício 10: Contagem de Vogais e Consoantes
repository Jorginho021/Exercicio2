package exercici10;

import java.util.Scanner;


public class Exercici10 {

    public static void main(String[] args) {
  Scanner sc = new Scanner(System.in);

        // Criar objeto Palavra
        Palavra palavra = new Palavra();

        // Solicitar ao usuário que digite uma palavra
        System.out.print("Digite uma palavra: ");
        String entrada = sc.nextLine();

        // Definir a palavra usando o setter
        palavra.setTexto(entrada);

        // Contar vogais e consoantes usando o método da classe
        palavra.contarVogaisConsoantes();

        sc.close();
    }
    
}

//Classe palavra
package exercici10;

public class Palavra {
     // Atributo privado
    private String texto;

    // Construtor
    public Palavra() {
    }

    public Palavra(String texto) {
        this.texto = texto;
    }

    // Getter
    public String getTexto() {
        return texto;
    }

    // Setter
    public void setTexto(String texto) {
        this.texto = texto;
    }

    // Método para contar vogais e consoantes
    public void contarVogaisConsoantes() {
        if (texto == null || texto.isEmpty()) {
            System.out.println("A palavra está vazia.");
            return;
        }

        int vogais = 0;
        int consoantes = 0;
        String palavraMinuscula = texto.toLowerCase();

        for (int i = 0; i < palavraMinuscula.length(); i++) {
            char c = palavraMinuscula.charAt(i);
            if (c >= 'a' && c <= 'z') { // Considera apenas letras
                if ("aeiou".indexOf(c) != -1) {
                    vogais++;
                } else {
                    consoantes++;
                }
            }
        }

        System.out.println("Vogais: " + vogais);
        System.out.println("Consoantes: " + consoantes);
    }
}




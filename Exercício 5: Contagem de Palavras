package exercicio5;

import java.util.Scanner;

public class Exercicio5 {

    public static void main(String[] args) {
        
        Scanner scanner = new Scanner(System.in);

        // Solicita que o usuário digite uma frase
        System.out.print("Digite uma frase: ");
        String frase = scanner.nextLine().trim();

        // Verifica se a frase está vazia
        if (frase.isEmpty()) {
            System.out.println("Você não digitou nenhuma palavra.");
        } else {
            // Divide a frase em palavras usando os espaços como separadores
            String[] palavras = frase.split("\\s+");

            // Exibe o resultado
            System.out.println("A frase possui " + palavras.length + " palavra(s).");
        }

        scanner.close();
    }
}

package exercici5;

import java.util.Scanner;


public class Exercici5 {

    
    public static void main(String[] args) {
     
        Scanner sc = new Scanner(System.in);

        // Criar objeto Frase
        Frase frase = new Frase();

        // Solicitar ao usuário que digite uma frase
        System.out.print("Digite uma frase: ");
        String entrada = sc.nextLine();

        // Definir a frase usando o setter
        frase.setTexto(entrada);

        // Contar palavras usando o método da classe
        int quantidadePalavras = frase.contarPalavras();

        // Exibir o resultado
        System.out.println("A frase possui " + quantidadePalavras + " palavra(s).");

        sc.close();
    }
    
}

//Classe Frase
package exercici5;


public class Frase {
        // Atributo privado
    private String texto;

    // Construtor
    public Frase() {
    }

    public Frase(String texto) {
        this.texto = texto;
    }

    // Getter
    public String getTexto() {
        return texto;
    }

    // Setter
    public void setTexto(String texto) {
        this.texto = texto;
    }

    // Método para contar palavras
    public int contarPalavras() {
        if (texto == null || texto.trim().isEmpty()) {
            return 0;
        }

        // Dividir a frase pelos espaços em branco
        String[] palavras = texto.trim().split("\\s+");
        return palavras.length;
    }
}



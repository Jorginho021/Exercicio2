
package exercicio02;

import java.util.Scanner;

public class Exercicio02 {

   
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        // Criar objeto Frase
        Frase frase = new Frase();

        // Solicitar ao usuário que digite uma frase
        System.out.print("Digite uma frase: ");
        String entrada = sc.nextLine();

        // Definir a frase usando o setter
        frase.setTexto(entrada);

        // Substituir 'a' por '*' usando o método da classe
        String fraseModificada = frase.substituirAsterisco();

        // Exibir o resultado
        System.out.println("Frase modificada: " + fraseModificada);

        sc.close();
    }
    }
//Classe Frase
package exercicio02;

public class Frase {
    
     // Atributo privado
    private String texto;

    // Construtor
    public Frase() {
    }

    public Frase(String texto) {
        this.texto = texto;
    }

    // Getter
    public String getTexto() {
        return texto;
    }

    // Setter
    public void setTexto(String texto) {
        this.texto = texto;
    }

    // Método para substituir 'a' por '*'
    public String substituirAsterisco() {
        if (texto != null) {
            return texto.replace('a', '*').replace('A', '*');
        } else {
            return "";
        }
    }
}

